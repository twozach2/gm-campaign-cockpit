*~
.fuse_hidden*
.directory
.Trash-*

# --- Editors ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# --- Build / cache artifacts (forward-compat in case deps are ever added) ---
dist/
build/
.cache/
coverage/
*.tsbuildinfo

