# --- Environment ---
# Never commit local configuration. Use .env.example as the template.
.env
.env.local
.env.*.local

# --- Runtime data ---
# Session notes backups are user-specific and machine-local.
data/backups/
data/trackers.json
data/*.corrupt
data/*.bak
data/*.tmp
relay/data/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

