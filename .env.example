# GM Campaign Cockpit configuration
#
# Copy this file to `.env` in the application folder. The server, validator,
# campaign scaffolder, and launchers read that file automatically.

# Folder containing your campaign folders. Each campaign needs a file named
# exactly "Director's Guide.md".
#
# Windows example:
# VAULT_ROOT=C:\Users\your-name\Documents\Dungeons_and_Dragons
#
# macOS example:
# VAULT_ROOT=/Users/your-name/Documents/Dungeons_and_Dragons
#
# If omitted, VAULT_ROOT defaults to the folder above this application.
# VAULT_ROOT=

# Local-only mode. This is the safest default and only accepts connections from
# the same computer.
HOST=127.0.0.1
PORT=4173

# Trusted-LAN mode requires all three settings below:
#
# HOST=0.0.0.0
# ALLOW_REMOTE_DM=true
# TABLE_PIN=choose-a-long-private-passphrase
#
# TABLE_PIN is required for LAN mode, must be at least six characters, and is
# never printed to logs. Share the player URL, not the DM PIN.
# TABLE_PIN=
# ALLOW_REMOTE_DM=false

# Localhost normally receives a DM session automatically. Set this to false
# only when you want the local browser to use the PIN login screen too.
# ALLOW_LOCAL_DM=true

# Optional comma-separated origins for trusted custom LAN hostnames.
# ALLOWED_ORIGINS=http://game-table.local:4173

# Runtime state. Defaults to the application-local `data` folder.
# Tracker state is stored as STATE_DIR/trackers.json.
# STATE_DIR=/absolute/path/to/gm-cockpit-state

# Experimental hosted-relay connector. For browser-guided pairing, configure
# only RELAY_CONTROL_URL. Leave every relay value blank for local/LAN-only use.
# Relay mode opens one outbound WSS connection and never opens an inbound
# public port.
#
# RELAY_CONTROL_URL=https://relay.example.com
#
# Managed installations may configure all four values below instead of using
# the pairing UI:
# RELAY_URL=wss://relay.example.com/v1/agent/active-room-id
# RELAY_AGENT_ID=paired-device-id
# RELAY_ROOM_ID=active-room-id
# RELAY_DEVICE_TOKEN=long-paired-device-token
#
# The URL may not contain credentials or query parameters. The device token is
# sent in the WebSocket protocol header and is never placed in the URL.
# RELAY_APP_VERSION=0.1.0

# Experimental separately-run hosted relay service. Its default listener is
# loopback-only. Public deployments must terminate TLS either in this process
# with both certificate settings or at a trusted managed reverse proxy.
#
# RELAY_HOST=127.0.0.1
# RELAY_PORT=8787
# RELAY_STATE_FILE=/absolute/path/to/relay-state.json
# RELAY_ASSET_DIR=/absolute/path/to/relay-assets
# RELAY_MAX_ASSET_BYTES=26214400
# Total hosted asset bytes allowed per account across all of its rooms
# (committed assets plus pending upload grants).
# RELAY_MAX_ASSET_BYTES_PER_ACCOUNT=262144000
# RELAY_ASSET_RETENTION_MS=604800000
# RELAY_ASSET_GRANT_TTL_MS=300000
# RELAY_MAX_LIMITER_KEYS=10000
# RELAY_MAX_ACCOUNTS=1000
# RELAY_MAX_DEVICES_PER_ACCOUNT=20
# RELAY_MAX_ACTIVE_ROOMS_PER_ACCOUNT=20
# RELAY_MAX_ACTIVE_INVITES_PER_ROOM=5
# RELAY_MAX_PLAYERS_PER_ROOM=200
# RELAY_MAX_PENDING_PAIRINGS_PER_ACCOUNT=10
# RELAY_MAX_ASSETS_PER_ROOM=100
# RELAY_MAX_PENDING_ASSET_GRANTS_PER_DEVICE=20
#
# Per-account login lockout. After this many consecutive failed logins the
# account is locked; the lock grows from the base toward the maximum duration
# and resets on the next successful login.
# RELAY_LOGIN_FAILURE_THRESHOLD=10
# RELAY_LOGIN_LOCK_BASE_MS=900000
# RELAY_LOGIN_LOCK_MAX_MS=86400000
# RELAY_METRICS_TOKEN=choose-a-long-private-monitoring-token
# RELAY_BACKUP_DIR=/absolute/path/to/relay-backups
#
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
# RELAY_TRUST_PROXY=false
# RELAY_PUBLIC_ORIGIN=https://relay.example.com
# RELAY_TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# RELAY_TLS_KEY_FILE=/absolute/path/to/private-key.pem
#
# Used only by `npm run relay:bootstrap`. Keep it out of command history.
# RELAY_BOOTSTRAP_PASSPHRASE=choose-a-long-account-passphrase
#
# Required only by `npm run relay:restore`. Stop the relay before restoring.
# RELAY_RESTORE_CONFIRM=RESTORE
#
# Staging check used by `npm run relay:soak`.
# RELAY_SOAK_URL=https://relay.example.com
# RELAY_SOAK_DURATION_SECONDS=300
# RELAY_SOAK_CONCURRENCY=5
# RELAY_SOAK_REGION=local

# Capacity limits. Defaults are above the needs of a typical table.
# MAX_CLIENTS=200
# MAX_STREAMS_PER_IP=40
# MAX_STREAMS_PER_IDENTITY=4
# MAX_PLAYERS=100
# MAX_DM_SESSIONS=32
# MAX_STREAM_TICKETS=256
# MAX_CHAT_MESSAGES=200
# MAX_PRESENTATION_ITEMS=100
# MAX_TRACKERS=100
# MAX_RETAINED_TEXT=600000
# MAX_FILE_BYTES=26214400
# MAX_LIMITER_KEYS=2000
