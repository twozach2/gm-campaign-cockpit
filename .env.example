# GM Campaign Cockpit configuration
#
# Copy this file to `.env` in the application folder. The server, validator,
# campaign scaffolder, and launchers read that file automatically.

# Folder containing your campaign folders. Each campaign needs a file named
# exactly "Director's Guide.md".
#
# Windows example:
# VAULT_ROOT=C:\Users\your-name\Documents\Dungeons_and_Dragons
#
# macOS example:
# VAULT_ROOT=/Users/your-name/Documents/Dungeons_and_Dragons
#
# If omitted, VAULT_ROOT defaults to the folder above this application.
# VAULT_ROOT=

# Local-only mode. This is the safest default and only accepts connections from
# the same computer.
HOST=127.0.0.1
PORT=4173

# Trusted-LAN mode requires all three settings below:
#
# HOST=0.0.0.0
# ALLOW_REMOTE_DM=true
# TABLE_PIN=choose-a-long-private-passphrase
#
# TABLE_PIN is required for LAN mode, must be at least six characters, and is
# never printed to logs. Share the player URL, not the DM PIN.
# TABLE_PIN=
# ALLOW_REMOTE_DM=false

# Localhost normally receives a DM session automatically. Set this to false
# only when you want the local browser to use the PIN login screen too.
# ALLOW_LOCAL_DM=true

# Optional comma-separated origins for trusted custom LAN hostnames.
# ALLOWED_ORIGINS=http://game-table.local:4173

# Runtime state. Defaults to the application-local `data` folder.
# Tracker state is stored as STATE_DIR/trackers.json.
# STATE_DIR=/absolute/path/to/gm-cockpit-state

# Experimental hosted-relay connector. Leave all four values blank for normal
# local/LAN use. Relay mode opens one outbound WSS connection; it never opens
# an inbound public port. A compatible hosted relay is not bundled yet.
#
# RELAY_URL=wss://relay.example.com/agent
# RELAY_AGENT_ID=paired-device-id
# RELAY_ROOM_ID=active-room-id
# RELAY_DEVICE_TOKEN=long-paired-device-token
#
# The URL may not contain credentials or query parameters. The device token is
# sent in the WebSocket protocol header and is never placed in the URL.
# RELAY_APP_VERSION=0.1.0

# Capacity limits. Defaults are above the needs of a typical table.
# MAX_CLIENTS=200
# MAX_STREAMS_PER_IP=40
# MAX_STREAMS_PER_IDENTITY=4
# MAX_PLAYERS=100
# MAX_DM_SESSIONS=32
# MAX_STREAM_TICKETS=256
# MAX_CHAT_MESSAGES=200
# MAX_PRESENTATION_ITEMS=100
# MAX_TRACKERS=100
# MAX_RETAINED_TEXT=600000
# MAX_FILE_BYTES=26214400
# MAX_LIMITER_KEYS=2000
